; User identity is sourced from ~/.gitconfig.local to avoid committing
; personal data in this repo. _install.sh can generate it from .env.
[include]
	path = ~/.gitconfig.local


[core]
	excludesfile = ~/.gitignore_global
	editor = nvim
	autocrlf = input

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	default = simple
	autoSetupRemote = true

[fetch]
	prune = true

[rebase]
	autoStash = true

[diff]
	colorMoved = zebra

[merge]
	conflictStyle = zdiff3

[alias]
	st = status -sb
	co = checkout
	br = branch
	cm = commit -m
	lg = log --oneline --graph --decorate --all
	last = log -1 HEAD --stat
	unstage = reset HEAD --
	amend = commit --amend --no-edit
	undo = reset --soft HEAD~1
